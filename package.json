{
  "name": "saucedemo-e2e",
  "version": "1.0.0",
  "description": "E2E tests for saucedemo.com with Playwright + Cucumber (TypeScript, Page Object Model)",
  "private": true,
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --profile smoke",
    "test:regression": "cucumber-js --profile regression",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:dry": "cucumber-js --dry-run",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/node": "^22.20.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.0",
    "@playwright/test": "^1.65.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
